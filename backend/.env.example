DB_HOST=localhost
DB_PORT=5432
DB_USER=change_me
DB_PASSWORD=change_me
DB_NAME=postgres
SECRET=change_me_random_string
PORT=3000
JWT_SECRET=change_me_base64_random_48_bytes
COOKIE_SECURE=false

# --- Tracker GPS (Foresight GPS) ---
FORESIGHT_BASIC_USER=change_me
FORESIGHT_BASIC_PASSWORD=change_me
FORESIGHT_CONNCODE=change_me

# --- Tracker GPS: listado de flota y reporte de comportamiento via el mismo
# API que usa el panel web GEvolution (cloud.ve.trackergps.com) -- ve toda la
# flota real de la cuenta, a diferencia de un wsuser/wspassword de servicio
# que solo ve un subconjunto. userid/companyid/reportid identifican la cuenta
# y el reporte guardado dentro de esa plataforma (no son secretos).
FORESIGHT_PLATFORM_API_URL=https://flexapi.foresightgps.com/ForesightFlexAPI.ashx
FORESIGHT_USERID=change_me
FORESIGHT_COMPANYID=change_me
FORESIGHT_REPORT_ID_COMPORTAMIENTO=change_me

# --- Tracker GPS: sincronizacion automatica y alertas (Fase 2) ---
# TRACKER_AUTO_SYNC controla la sincronizacion y las alertas de fuera de
# horario/fuera de zona (se evaluan justo despues de sincronizar).
# TRACKER_SYNC_CRON admite uno o varios horarios separados por ';', util para
# revisar solo unas pocas veces al dia en vez de cada 10 minutos (ej.
# '5 20 * * *;35 20 * * *;0 21 * * *' revisa a las 8:05pm, 8:35pm y 9:00pm).
TRACKER_AUTO_SYNC=true
TRACKER_SYNC_CRON=*/10 * * * *
TRACKER_STALE_HOURS=24
TRACKER_CURFEW_HOUR=20
TRACKER_RETENTION_MONTHS=6
TRACKER_ARCHIVE_CRON=0 3 * * *
TRACKER_ANALISIS_CRON=30 23 * * *
# TRACKER_AUTO_REPORTS controla, por separado, el archivado de retencion, los
# reportes de turno por Telegram, el recordatorio de anexo de seguridad y el
# analisis diario de comportamiento -- en false (o ausente) quedan manuales
# (botones de la pantalla de Reportes), sin afectar la sincronizacion/alertas
# de arriba.
TRACKER_AUTO_REPORTS=true
TELEGRAM_BOT_TOKEN=change_me
# Opcional: chat_id(s) fijos separados por coma, además de los suscriptores
# automáticos (cualquiera que le escriba /start al bot queda registrado
# solo en la tabla tracker_telegram_subscriber -- no hace falta tocar esto).
TELEGRAM_CHAT_ID=
