# Configuración de la app en Azure (Portal → la app → Configuration →
# Application settings). PLANTILLA: aquí no va ningún valor real. Los
# secretos se cargan directo en Azure, copiados del backend/.env de la
# máquina de origen. Ver DEPLOY_AZURE.md.

# ---------- Plataforma ----------
WEBSITES_PORT=8080                 # puerto del contenedor (fijo en el Dockerfile)
NODE_ENV=production
WEB_CONCURRENCY=2                  # procesos PM2 por instancia (= vCPU del plan)
TRUST_PROXY=1                      # saltos de proxy delante (Front Door delante = 2)
RUN_MIGRATIONS_ON_START=true       # aplica migraciones pendientes al arrancar
SCHEDULER_ENABLED=false            # false hasta el go-live (paso 7); luego true SOLO aquí
# INITIAL_ADMIN_PASSWORD=          # OPCIONAL: otra contraseña para "admin" en la instalación desde cero (si no, la de db/seed.sql)
# Ya vienen en la imagen, solo cambiarlos si se sabe por qué:
# FRONTEND_DIST_DIR=/app/frontend-dist   API_AT_ROOT=false   UPLOADS_DIR=/data/uploads
# PDF_CHROME_PATH=/usr/bin/chromium      TZ=America/Caracas  MIGRATIONS_DIR=/app/db/migrations

# ---------- Base de datos (Azure Database for PostgreSQL) ----------
DB_HOST=<servidor>.postgres.database.azure.com
DB_PORT=5432
DB_NAME=fullpetro
DB_USER=fullpetro_app               # usuario LIMITADO (solo datos), ver DEPLOY_AZURE.md §4.1b
DB_PASSWORD=<SECRETO>
MIGRATION_DB_USER=<usuario admin de PostgreSQL>   # solo para las migraciones al arrancar
MIGRATION_DB_PASSWORD=<SECRETO>
DB_SSL=true                        # obligatorio en Azure
DB_POOL_MAX=6                      # conexiones por proceso; 6 con PostgreSQL B1ms (ver DEPLOY_AZURE.md §9)
DB_STATEMENT_TIMEOUT_MS=30000      # corta consultas colgadas
# DB_CONNECTION_TIMEOUT_MS=5000

# ---------- Sesión y seguridad ----------
SECRET=<SECRETO: openssl rand -hex 32>      # firma de la cookie de sesión (NUEVO, no el de desarrollo)
JWT_SECRET=<SECRETO: openssl rand -hex 32>  # firma de los tokens (NUEVO)
SESSION_IDLE_MINUTES=30            # la sesión se cierra tras estos minutos SIN actividad (se renueva mientras se usa)
COOKIE_SECURE=true                 # cookie solo por HTTPS
FRONTEND_URL=https://<app>.azurewebsites.net   # o https://app.fullpetro.com (dominio público de la app)

# ---------- Tracker GPS (Foresight / GEvolution) ----------
FORESIGHT_PLATFORM_API_URL=
FORESIGHT_USERID=
FORESIGHT_COMPANYID=
FORESIGHT_CONNCODE=<SECRETO>
FORESIGHT_BASIC_USER=<SECRETO>
FORESIGHT_BASIC_PASSWORD=<SECRETO>
FORESIGHT_REPORT_ID_COMPORTAMIENTO=134
FORESIGHT_V3_URL=
FORESIGHT_WSUSER=<SECRETO>
FORESIGHT_WSPASSWORD=<SECRETO>

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=<SECRETO>
TELEGRAM_CHAT_ID=                  # chat_id que reciben siempre (separados por coma)

# ---------- Horarios y reglas (copiar los valores del .env de la laptop de Luis) ----------
TRACKER_AUTO_SYNC=
TRACKER_SYNC_CRON=
TRACKER_STALE_HOURS=
TRACKER_CURFEW_HOUR=
TRACKER_GEOFENCE_EVENTS_CRON=
TRACKER_GEOFENCE_DAY_START_HOUR=
TRACKER_GEOFENCE_MAX_DELAY_MIN=
TRACKER_GEOCERCAS_CRON=
TRACKER_RETENTION_MONTHS=
TRACKER_ARCHIVE_CRON=
TRACKER_ALERT_RETENTION_DAYS=
TRACKER_ALERT_CLEANUP_CRON=
TRACKER_ANALISIS_CRON=
TRACKER_NOTIFY_ANEXO_CRON=
TRACKER_AUTO_REPORTES_TURNO=
TRACKER_AUTO_REPORTS=
FLEET_GPS_ODOMETER_CRON=
FLEET_DOCS_ALERT_CRON=off          # EN PAUSA hasta que Lguerra tenga autorización (ver CLAUDE.md)
MNT_PREVENTIVA_CRON=
